rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      // Any signed-in user: the join-by-code flow queries by inviteCode and
      // arrayUnions itself into memberUids before being a member.
      allow read, write: if signedIn();

      // "Cómo me pagan": members read it, only its owner writes it.
      match /members/{uid} {
        allow read:  if isMember(groupId);
        allow write: if isMember(groupId) && request.auth.uid == uid;
      }

      // Payment requests ("cobros"): written only by Cloud Functions (admin SDK).
      match /paymentRequests/{requestId} {
        allow read:  if isMember(groupId);
        allow write: if false;
      }

      // Automatic charges: doc id = the creditor's uid; only they set it up.
      // (autoBilling adds lastRunKey/lastRunAt with the admin SDK.)
      // Private: only its owner sees it; the others only see the request once it is sent.
      match /autoCharges/{uid} {
        allow read:  if isMember(groupId) && request.auth.uid == uid;
        allow write: if isMember(groupId) && request.auth.uid == uid;
      }

      // Recurring fixed expenses: private to their creator (the others see the expense when it is
      // added and the request when it is sent); only the creator edits or deletes;
      // one that sends charges must be in the creator's own name (creator == payer).
      // (autoBilling maintains nextRunAt/lastRunAt/runs with the admin SDK.)
      match /recurring/{ruleId} {
        function chargesOnlyAsPayer() {
          return request.resource.data.get('sendCharge', false) != true
            || request.resource.data.get('payerUid', null) == request.auth.uid;
        }
        allow read:   if isMember(groupId) && resource.data.createdByUid == request.auth.uid;
        allow create: if isMember(groupId)
          && request.resource.data.get('createdByUid', null) == request.auth.uid
          && chargesOnlyAsPayer();
        allow update: if isMember(groupId)
          && resource.data.get('createdByUid', null) == request.auth.uid
          && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
          && chargesOnlyAsPayer();
        allow delete: if isMember(groupId)
          && resource.data.get('createdByUid', null) == request.auth.uid;
      }

      // expenses, budgets and any other subcollection: members only.
      // Rules OR together, so the subcollections with their own stricter rules
      // above are left out of this write rule.
      match /{sub}/{doc=**} {
        // autoCharges and recurring are private: only their own read rules above apply
        allow read:  if isMember(groupId) && !(sub in ['autoCharges', 'recurring']);
        allow write: if isMember(groupId)
          && !(sub in ['members', 'paymentRequests', 'autoCharges', 'recurring']);
      }
    }
  }
}
