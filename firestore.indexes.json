        { "fieldPath": "dueAt", "order": "ASCENDING" }
      ]
    },
    {
      "collectionGroup": "recurring",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "active", "order": "ASCENDING" },
        { "fieldPath": "nextRunAt", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": [
    {
